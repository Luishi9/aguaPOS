// Prisma schema para sistema de reparto de agua
// Base de datos: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ====================
// SUCURSAL (Branch)
// ====================
model Branch {
  id               String   @id @default(cuid())
  name             String
  address          String?
  phone            String?
  defaultUnitPrice Decimal  @default(2500) @db.Decimal(10, 2)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users      User[]
  clients    Client[]
  sales      Sale[]
  inventory  Inventory[]

  @@map("branches")
}

// ====================
// USUARIO (User)
// ====================
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  password     String
  role         UserRole @default(SELLER)
  isActive     Boolean  @default(true)
  branchId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  branch Branch? @relation(fields: [branchId], references: [id])
  sales  Sale[]

  @@map("users")
}

enum UserRole {
  ADMIN
  SELLER
}

// ====================
// CLIENTE (Client)
// ====================
model Client {
  id                 String   @id @default(cuid())
  name               String
  phone              String?
  address            String?
  email              String?
  branchId           String
  currentBalance     Decimal  @default(0) @db.Decimal(10, 2) // deuda acumulada (positivo = debe)
  containersOwed     Int      @default(0) // envases en poder del cliente
  isActive           Boolean  @default(true)
  notes              String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  branch           Branch           @relation(fields: [branchId], references: [id])
  sales            Sale[]
  accountMovements AccountMovement[]

  @@map("clients")
}

// ====================
// VENTA (Sale)
// ====================
model Sale {
  id                  String     @id @default(cuid())
  saleNumber          String     @unique
  clientId            String
  branchId            String
  userId              String
  status              SaleStatus @default(COMPLETED)

  // Bidones
  containersDelivered Int        @default(0) // entregados
  containersReturned  Int        @default(0) // retirados/devueltos
  containersNet       Int        @default(0) // neto (entregados - retirados)

  // Montos
  unitPrice           Decimal    @db.Decimal(10, 2)
  subtotal            Decimal    @db.Decimal(10, 2)
  discount            Decimal    @default(0) @db.Decimal(10, 2)
  total               Decimal    @db.Decimal(10, 2)

  // Pago
  amountPaid          Decimal    @default(0) @db.Decimal(10, 2)
  paymentMethod       PaymentMethod @default(CASH)
  notes               String?    @db.Text

  saleDate            DateTime   @default(now())
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  client           Client           @relation(fields: [clientId], references: [id])
  branch           Branch           @relation(fields: [branchId], references: [id])
  user             User             @relation(fields: [userId], references: [id])
  accountMovements AccountMovement[]

  @@map("sales")
}

enum SaleStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  TRANSFER
  CHECK
  CREDIT
}

// ====================
// MOVIMIENTO DE CUENTA CORRIENTE
// ====================
model AccountMovement {
  id          String          @id @default(cuid())
  clientId    String
  saleId      String?
  type        MovementType
  amount      Decimal         @db.Decimal(10, 2)
  balance     Decimal         @db.Decimal(10, 2) // saldo después del movimiento
  description String?
  paymentMethod PaymentMethod?
  createdAt   DateTime        @default(now())

  client Client  @relation(fields: [clientId], references: [id])
  sale   Sale?   @relation(fields: [saleId], references: [id])

  @@map("account_movements")
}

enum MovementType {
  SALE      // genera deuda
  PAYMENT   // pago del cliente
  ADJUSTMENT // ajuste manual
}

// ====================
// INVENTARIO
// ====================
model Inventory {
  id               String   @id @default(cuid())
  branchId         String   @unique
  fullContainers   Int      @default(0) // bidones llenos disponibles
  emptyContainers  Int      @default(0) // envases vacíos en stock
  updatedAt        DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id])

  @@map("inventory")
}

// ====================
// MOVIMIENTO DE INVENTARIO
// ====================
model InventoryMovement {
  id          String                @id @default(cuid())
  branchId    String
  type        InventoryMovementType
  fullIn      Int                   @default(0)
  fullOut     Int                   @default(0)
  emptyIn     Int                   @default(0)
  emptyOut    Int                   @default(0)
  description String?
  createdAt   DateTime              @default(now())

  @@map("inventory_movements")
}

enum InventoryMovementType {
  SALE
  RETURN
  PURCHASE
  ADJUSTMENT
}
